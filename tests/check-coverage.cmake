# 索引・Verify宣言・ドキュメントのリンクが一致することを構成時に検査する。
file(STRINGS "${PROJECT_SOURCE_DIR}/docs/README.md" index_lines)
set(index_headers)
set(index_pages)
foreach(line IN LISTS index_lines)
  if(line MATCHES [=[\]\(\.\./([^)]*\.hpp)\).*\]\(([^)]*\.md)\)]=])
    list(APPEND index_headers "${CMAKE_MATCH_1}")
    list(APPEND index_pages "${CMAKE_MATCH_2}")
  endif()
endforeach()
if(NOT index_headers)
  message(FATAL_ERROR "No headers found in docs/README.md")
endif()

foreach(source IN LISTS unit_sources)
  file(STRINGS "${source}" declarations REGEX "^// Verify: ")
  if(NOT declarations)
    message(FATAL_ERROR "Missing Verify declaration: ${source}")
  endif()
  foreach(declaration IN LISTS declarations)
    string(REPLACE "// Verify: " "" header "${declaration}")
    if(NOT header IN_LIST index_headers OR NOT EXISTS "${PROJECT_SOURCE_DIR}/${header}")
      message(FATAL_ERROR "Unknown Verify header '${header}' in ${source}")
    endif()
    string(SHA256 key "${header}")
    list(APPEND "tests_for_${key}" "${source}")
  endforeach()
endforeach()

list(LENGTH index_headers header_count)
math(EXPR last_header "${header_count} - 1")
foreach(i RANGE 0 ${last_header})
  list(GET index_headers ${i} header)
  list(GET index_pages ${i} page)
  string(SHA256 key "${header}")
  if(NOT tests_for_${key})
    message(FATAL_ERROR "No unit test for indexed header: ${header}")
  endif()
  file(READ "${PROJECT_SOURCE_DIR}/docs/${page}" documentation)
  foreach(source IN LISTS tests_for_${key})
    file(RELATIVE_PATH relative_source "${PROJECT_SOURCE_DIR}" "${source}")
    string(FIND "${documentation}" "(../../${relative_source})" link_position)
    if(link_position EQUAL -1)
      message(FATAL_ERROR "Missing Verify link to ${relative_source} in docs/${page}")
    endif()
  endforeach()
  # 古いOJ検証へのリンクや、削除されたテストへのリンクも検出する。
  if(documentation MATCHES [=[\]\([^)]*/verify/]=])
    message(FATAL_ERROR "Legacy verification link remains in docs/${page}")
  endif()
  string(REGEX MATCHALL [=[\.\./\.\./tests/unit/[^)]*\.cpp]=] links "${documentation}")
  foreach(link IN LISTS links)
    string(REGEX REPLACE [=[^\.\./\.\./]=] "" relative_source "${link}")
    if(NOT "${PROJECT_SOURCE_DIR}/${relative_source}" IN_LIST unit_sources)
      message(FATAL_ERROR "Verify link does not point to a registered test: ${link}")
    endif()
  endforeach()
endforeach()
list(LENGTH unit_sources test_count)
message(STATUS "Verify coverage: ${header_count} indexed headers, ${test_count} standalone tests")
